{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "vite build",
    "start": "node backend/server.ts",
    "db:migrate": "tsx backend/scripts/migrate.ts",
    "preview": "vite preview",
    "clean": "rm -rf frontend/dist dist server.js",
    "lint": "tsc --noEmit",
    "godot:export": "godot --headless --path frontend/godot --export-pack \"Web\" ../public/godot/maze_runner.pck && node frontend/scripts/pack-godot-wasm.mjs",
    "godot:export:full": "godot --headless --path frontend/godot --export-release \"Web\" ../public/godot/maze_runner.html && node frontend/scripts/pack-godot-wasm.mjs",
    "apk:sync": "node frontend/scripts/build-apk.mjs sync",
    "apk:build": "node frontend/scripts/build-apk.mjs build",
    "apk:open": "node frontend/scripts/build-apk.mjs open"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@neon/neon-js": "^0.10.2",
    "@neon/realtime": "^0.2.0",
    "@neon/realtime-react": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
