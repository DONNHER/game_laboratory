APP_NAME="MazeRunnerBackend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite
# Or MySQL for school lab server:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maze_runner
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Laravel Reverb WebSockets Configuration
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=maze-runner-app
REVERB_APP_KEY=maze-runner-key
REVERB_APP_SECRET=maze-runner-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
