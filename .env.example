# GEMINI_API_KEY: Optional server-side Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the backend is hosted.
APP_URL="MY_APP_URL"

# VITE_WS_URL: Hosted backend URL for standalone Android APK / separate frontend builds.
# Accepts wss://your-backend.onrender.com/ws OR https://your-backend.onrender.com (auto-converted to wss://.../ws).
# Leave empty when serving frontend and backend together on the same host.
VITE_WS_URL=""
